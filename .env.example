# ─── Laya Music – Environment Variables Template ───────────────────────────
# Copy this file to .env (or set these as GitHub Secrets / local shell vars).
# Never commit the real .env file.

# ── YouTube Music internal API key ─────────────────────────────────────────
# Used by the YTM API client (browse, create playlist, account menu, etc.)
# This key is the same one embedded in the YouTube Music web app; it is
# technically public, but we keep it out of source for hygiene.
YTM_API_KEY=YOUR_YTM_API_KEY_HERE

# ── Release signing ─────────────────────────────────────────────────────────
# Set in GitHub Secrets for CI or in your local shell before running Gradle.
# The keystore file must exist at app/laya-release.jks (local) or be decoded
# from the KEYSTORE_BASE64 secret by the CI workflow.
KEYSTORE_PASSWORD=YOUR_KEYSTORE_PASSWORD
KEY_ALIAS=YOUR_KEY_ALIAS
KEY_PASSWORD=YOUR_KEY_PASSWORD
